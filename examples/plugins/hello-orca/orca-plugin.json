{
  "manifestVersion": 1,
  "id": "hello-orca",
  "publisher": "orca-samples",
  "name": "Hello Orca",
  "version": "1.0.0",
  "description": "Sample plugin combining a sandboxed panel, worker commands, a worktree badge, and event subscriptions.",
  "engines": { "orca": ">=1.4.0" },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [{ "id": "hello", "title": "Hello Orca", "icon": "plug", "entry": "panel.html" }],
    "commands": [
      { "id": "hello-ping", "title": "Hello: Ping" },
      { "id": "hello-worktree", "title": "Hello: Show folder", "context": "worktree" }
    ],
    "events": [{ "on": "worktree.created" }, { "on": "agent.status.changed" }],
    "worktreeBadges": [
      {
        "id": "node-project",
        "title": "Node project",
        "icon": "package",
        "when": { "pathExists": ["package.json"] },
        "commands": ["hello-worktree"]
      }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "terminal:send" },
    { "kind": "notifications:show" },
    { "kind": "storage" },
    { "kind": "events:subscribe" }
  ]
}
